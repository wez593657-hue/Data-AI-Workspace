-- ============================================================
-- 客户资产负债基数处理存储过程临时表重建语句
-- 存储过程名称: PRC_DWS_CUST_ASSE_LIAB_CUMU
-- 处理方式: DROP TABLE IF EXISTS + CREATE TABLE
-- 临时表数量: 5
-- 说明: 字段维度与过程当前版本保持一致；不新增默认值、序列、主键或索引。
-- ============================================================

-- 01: 保险当日余额临时表
-- 粒度: 客户、账户、产品、产品大类、渠道、办理日期、投保单号、法人行号、机构
DROP TABLE IF EXISTS TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL;

CREATE TABLE TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL (
    DATA_DATE             VARCHAR(8)    NULL, -- 数据日期，格式YYYYMMDD
    CUST_ID               VARCHAR(20)   NULL, -- 客户号
    ACCT_ID               VARCHAR(40)   NULL, -- 账号
    PRDKT_ID              VARCHAR(40)   NULL, -- 产品编号
    PRDKT_CATE_BIG        VARCHAR(40)   NULL, -- 产品大类
    CHNL_NO               VARCHAR(10)   NULL, -- 办理渠道，来源DWD_ACCT_INSUR.TX_CHNL
    ISSU_DATE             VARCHAR(10)   NULL, -- 办理日期，来源DWD_ACCT_INSUR.TX_DATE
    IOU_NO                VARCHAR(100)  NULL, -- 投保单号，来源DWD_ACCT_INSUR.INSUR_BID_FORM_NO
    BAL                   NUMBER(20,2)  NULL, -- 当日保险余额
    PERSN_LEGAL_BK_CODE   VARCHAR(4)    NULL, -- 法人行号
    OPRT_ORG              VARCHAR(7)    NULL  -- 归属机构，来源DWD_ACCT_INSUR.MKT_ORG
);

COMMENT ON TABLE TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL IS '客户资产负债基数保险当日余额临时表';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.DATA_DATE IS '数据日期，格式YYYYMMDD';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.CUST_ID IS '客户号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.ACCT_ID IS '账号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.PRDKT_ID IS '产品编号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.PRDKT_CATE_BIG IS '产品大类';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.CHNL_NO IS '办理渠道，来源DWD_ACCT_INSUR.TX_CHNL';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.ISSU_DATE IS '办理日期，来源DWD_ACCT_INSUR.TX_DATE';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.IOU_NO IS '投保单号，来源DWD_ACCT_INSUR.INSUR_BID_FORM_NO';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.BAL IS '当日保险余额';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.PERSN_LEGAL_BK_CODE IS '法人行号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_INSUR_BAL.OPRT_ORG IS '归属机构，来源DWD_ACCT_INSUR.MKT_ORG';

-- 02: 四类产品当日余额明细临时表
-- 粒度: 法人行号、机构、客户、账户、产品、产品大类、渠道、办理日期、投保单号/借据号、产品类型
DROP TABLE IF EXISTS TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL;

CREATE TABLE TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL (
    DATA_DATE             VARCHAR(8)    NULL, -- 数据日期，格式YYYYMMDD
    PERSN_LEGAL_BK_CODE   VARCHAR(4)    NULL, -- 法人行号
    OPRT_ORG              VARCHAR(7)    NULL, -- 归属机构
    CUST_ID               VARCHAR(20)   NULL, -- 客户号
    ACCT_ID               VARCHAR(40)   NULL, -- 账号
    PRDKT_ID              VARCHAR(40)   NULL, -- 产品编号
    PRDKT_CATE_BIG        VARCHAR(40)   NULL, -- 产品大类
    CHNL_NO               VARCHAR(10)   NULL, -- 办理渠道，保险取TX_CHNL，理财取CHNL_NO
    ISSU_DATE             VARCHAR(10)   NULL, -- 办理日期，按产品来源字段传递
    IOU_NO                VARCHAR(100)  NULL, -- 投保单号或者借据号
    BAL                   NUMBER(20,2)  NULL, -- 产品当日余额
    PRDKT_TYP             VARCHAR(1)    NULL  -- 产品类型，1存款/2贷款/3理财/4保险
);

COMMENT ON TABLE TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL IS '客户资产负债基数四类产品当日余额明细临时表';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.DATA_DATE IS '数据日期，格式YYYYMMDD';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.PERSN_LEGAL_BK_CODE IS '法人行号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.OPRT_ORG IS '归属机构';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.CUST_ID IS '客户号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.ACCT_ID IS '账号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.PRDKT_ID IS '产品编号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.PRDKT_CATE_BIG IS '产品大类';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.CHNL_NO IS '办理渠道，保险取TX_CHNL，理财取CHNL_NO';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.ISSU_DATE IS '办理日期，按产品来源字段传递';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.IOU_NO IS '投保单号或者借据号';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.BAL IS '产品当日余额';
COMMENT ON COLUMN TMP_DWS_CUST_ASSE_LIAB_TODAY_BAL.PRDKT_TYP IS '产品类型，1存款/2贷款/3理财/4保险';


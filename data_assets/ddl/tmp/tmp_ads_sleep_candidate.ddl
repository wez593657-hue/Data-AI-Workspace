/*
 * TMP_ADS_SLEEP_CANDIDATE
 * 中文名称: 睡眠户候选客户临时表
 * 版本: v2.10.0
 * 创建时间: 2026-07-30
 * 用途: 存储当日首次满足AUM<100且近365天无JIOYCFFS='0'主动动账的候选客户，
 *       与基础清单按法人行号+客户号+机构号排重后合并。
 */

CREATE TABLE IF NOT EXISTS TMP_ADS_SLEEP_CANDIDATE (
    PERSN_LEGAL_BK_CODE VARCHAR(4),
    CUST_ID VARCHAR(20),
    CUST_NAME VARCHAR(100),
    CUST_LVL VARCHAR(2),
    DEPO_CURNT_DEPO_BAL NUMBER(20,2),
    FIXD_DEPO_BAL NUMBER(20,2),
    FIN_AMT NUMBER(20,2),
    INSUR_AMT NUMBER(20,2),
    POST_ID VARCHAR(20),
    ORG_ID VARCHAR(7)
);

COMMENT ON TABLE TMP_ADS_SLEEP_CANDIDATE IS '睡眠户候选客户临时表';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.PERSN_LEGAL_BK_CODE IS '法人行号：VARCHAR(4)，与客户号、机构号构成业务粒度。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.CUST_ID IS '客户编号：VARCHAR(20)，候选客户唯一标识。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.CUST_NAME IS '客户名称：VARCHAR(100)，客户展示名称。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.CUST_LVL IS '客户等级：VARCHAR(2)，来源等级快照，允许空值。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.DEPO_CURNT_DEPO_BAL IS '活期余额：NUMBER(20,2)，金额元，缺失按0处理。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.FIXD_DEPO_BAL IS '定期余额：NUMBER(20,2)，金额元，缺失按0处理。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.FIN_AMT IS '理财余额：NUMBER(20,2)，金额元，缺失按0处理。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.INSUR_AMT IS '保险余额：NUMBER(20,2)，金额元，缺失按0处理。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.POST_ID IS '管户经理：VARCHAR(20)，理财管户经理编号，允许空值。';
COMMENT ON COLUMN TMP_ADS_SLEEP_CANDIDATE.ORG_ID IS '归属机构：VARCHAR(7)，来源资产快照机构编码。';
